# Modèle de configuration : copier en .env puis remplacer les valeurs.
#   cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
#
# Générer une clé solide :  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Identifiants de la base Postgres (éviter les caractères @ : / dans le mot de passe).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
